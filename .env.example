NEXT_PUBLIC_URL=http://localhost:3000

# Optional: the host the admin is served on, without https://. Left empty, the
# admin stays at /admin. See docs/05-CMS.md, "Admin address"
NEXT_PUBLIC_ADMIN_HOST=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for scripts/import-content.mts, never exposed to the site.
# Supabase → Project Settings → API → secret (or legacy service_role) key
SUPABASE_SECRET_KEY=

# The media bucket on Cloudflare R2, see docs/05-CMS.md, "Media on R2".
# The keys stay on the server: R2 → API Tokens, Object Read & Write on the
# bucket, "credentials for S3 clients". The account ID is in R2 → Overview
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media
# The bucket's custom domain, without a trailing slash
NEXT_PUBLIC_MEDIA_URL=https://media.example.com
