{
    "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
    "extends": ["biome-config-pixel"],
    "overrides": [
        {
            "includes": ["packages/**"],
            "linter": { "enabled": false },
            "formatter": { "enabled": false },
            "assist": { "enabled": false }
        },
        {
            "includes": ["scripts/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": "off"
                    }
                }
            }
        }
    ]
}
